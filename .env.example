# Variables para parametrizar imágenes según ADR0025
# Copiá este archivo a .env y ajustá según ambiente.

# Registry e imagen
IMAGE_REGISTRY=ghcr.io
IMAGE_REPO=DarkyDieLJob/gestionferreteria

# Staging: alias mutable
IMAGE_TAG=staging-latest

# Producción: descomentá y seteá la versión fija (nunca uses latest en prod)
# IMAGE_TAG=vX.Y.Z

# Sugerencias de uso:
# - En staging, el workflow Build & Push (pre-release) publica staging-latest.
# - En producción, el workflow Build & Push (release/tag) publica vX.Y.Z.
# - El deploy (staging/prod) hace pull + up usando estas variables.
